# ---------------------------------------------------------------------------
# Dot Lab configuration. Copy to .env and fill in. NEVER commit your .env.
# ---------------------------------------------------------------------------

# --- OpenAI (required to run tasks) ---------------------------------------
OPENAI_API_KEY=
# Any model that supports Structured Outputs on the Responses API.
# Check https://platform.openai.com/docs/models for current names.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Storage ---------------------------------------------------------------
# Default: sqlite file at ./data/dot_lab.db
DATABASE_URL=sqlite:///./data/dot_lab.db
# The ONLY directory the filesystem tool can access.
WORKSPACE_DIR=./data/workspace

# --- Web search (optional) -------------------------------------------------
# none | tavily | brave
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# --- Browser tool ----------------------------------------------------------
# httpx (default, no JavaScript) | playwright (optional dependency)
BROWSER_BACKEND=httpx
# Comma-separated allow-list, e.g. "arxiv.org,github.com". Empty = any public site.
BROWSER_ALLOWED_DOMAINS=
# Keep false unless you understand the SSRF risk.
BROWSER_ALLOW_PRIVATE_NETWORKS=false
BROWSER_MAX_CHARS=20000

# --- Notifications (optional) ----------------------------------------------
# External webhook; every webhook message requires human approval.
NOTIFICATION_WEBHOOK_URL=

# --- Agent safety limits ---------------------------------------------------
MAX_AGENT_ITERATIONS=30
MAX_PLAN_STEPS=8
MAX_STEP_RETRIES=2
MAX_REPLANS=1
TOOL_TIMEOUT_SECONDS=30
TASK_TIMEOUT_SECONDS=900
MAX_CONCURRENT_TASKS=2
MAX_GOAL_LENGTH=2000
# Comma-separated tool names that ALWAYS need approval, e.g. "filesystem,browser"
APPROVAL_REQUIRED_TOOLS=
# What happens when a human rejects an action: skip (continue without it) | fail
APPROVAL_REJECTION_POLICY=skip

# --- Monitoring mode -------------------------------------------------------
ENABLE_MONITOR_SCHEDULER=true
MONITOR_POLL_SECONDS=30
MONITOR_MIN_INTERVAL_MINUTES=5

# --- Server ----------------------------------------------------------------
# If set, every /api request (except /api/health) needs header X-API-Key.
# Strongly recommended if the server is reachable by anyone but you.
DOT_LAB_API_KEY=
LOG_LEVEL=INFO
LOG_JSON=true
